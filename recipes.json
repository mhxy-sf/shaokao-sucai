    {
      "name": "鲜椒牛肋条（双椒牛肉）",
      "date": "2026-05-24",
      "tags": ["腌制", "牛肋条", "双椒"],
      "ingredients": [
        { "name": "啤酒", "amount": "8 克" },
        { "name": "蚝油", "amount": "4 克" },
        { "name": "生抽", "amount": "8 克" },
        { "name": "味精", "amount": "2 克" },
        { "name": "鸡精", "amount": "2 克" },
        { "name": "白糖", "amount": "3 克" },
        { "name": "红薯淀粉（化开）", "amount": "4 克" },
        { "name": "大豆油（封水）", "amount": "6 克" },
        { "name": "鲜椒碎", "amount": "充分裹匀" }
      ],
      "steps": [
        "预调鲜椒碎：姜 5 份、蒜 5 份、红小米辣 20 份、青小米辣 30 份，搅拌成碎；",
        "上述调料倒入 150 克牛肋条中抓拌；",
        "放入红薯淀粉 4 克化开，再放 6 克大豆油抓油封水；",
        "最后放鲜椒碎，充分裹匀，腌制 10 分钟后穿串。"
      ],
      "note": "经营建议：周末可先多打些鲜椒碎备用；牛肋条基础腌制后一部分放鲜椒，另一部分预留，现场卖得好再现拌。卖不完的牛肋条可单独保存基础腌制（不含鲜椒碎），第二天再制作鲜椒碎。",
      "images": []
    },
